{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SigmaAgents",
  "identifier": "ai.opencode.desktop",
  "mainBinaryName": "SigmaAgents",
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/prod/32x32.png",
      "icons/prod/128x128.png",
      "icons/prod/128x128@2x.png",
      "icons/prod/icon.icns",
      "icons/prod/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/prod/icon.ico"
      },
      "wix": {
        "fragmentPaths": ["wix/resources.wxs"],
        "componentGroupRefs": ["AppResources"],
        "template": "wix/main.wxs",
        "language": {
          "en-US": {
            "localePath": "locales/en-US.wxl"
          }
        }
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/ai.opencode.opencode.metainfo.xml": "release/appstream.metainfo.xml"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    },
    "resources": {
      "resources-dist/": ""
    },
    "externalBin": ["sidecars/opencode"]
  },
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun run generate-wix-resources --config src-tauri/tauri.prod.conf.json",
    "frontendDist": "../dist"
  },
  "build": {
    "beforeBundleCommand": "bun run generate-wix-resources --config src-tauri/tauri.prod.conf.json"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwMDM5Nzg5OUMzOUExMDQKUldRRW9UbWNpWmNEOENYT01CV0lhOXR1UFhpaXJsK1Z3aU9lZnNtNzE0TDROWVMwVW9XQnFOelkK",
      "endpoints": ["https://github.com/anomalyco/opencode/releases/latest/download/latest.json"]
    }
  }
}
