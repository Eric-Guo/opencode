{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SigmaAgents Dev",
  "identifier": "ai.opencode.desktop.dev",
  "mainBinaryName": "SigmaAgents",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "bun run prepare-resources && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun run generate-silent-install && bun run generate-wix-resources --config src-tauri/tauri.conf.json",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi", "app"],
    "externalBin": ["sidecars/opencode"],
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/dev/icon.ico",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp"
      },
      "wix": {
        "fragmentPaths": ["wix/resources.wxs"],
        "componentGroupRefs": ["AppResources"],
        "template": "wix/main.wxs",
        "language": {
          "en-US": {
            "localePath": "locales/en-US.wxl"
          }
        },
        "upgradeCode": "12345678-1234-1234-1234-123456789012"
      }
    },
    "resources": {
      "resources-dist/": ""
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["opencode"]
      }
    }
  }
}
