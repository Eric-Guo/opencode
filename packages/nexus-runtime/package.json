{
  "name": "@opencode/nexus-runtime",
  "version": "2.4.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/nexus-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/runtime.ts",
    "./editor": "./src/editor.ts",
    "./jobs": "./src/jobs.ts",
    "./persona": "./src/persona.ts",
    "./terminal-runs": "./src/terminal-runs.ts",
    "./web": "./src/web.ts",
    "./run": "./src/run.ts",
    "./experimental/history": "./src/recorded-history.ts",
    "./experimental/executor": "./src/executor.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test test",
    "typecheck": "bun check --project tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "test:conformance": "bun run script/conformance.ts"
  },
  "bundledDependencies": [
    "@cybros/agent"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "1.6.0",
    "@cybros/agent": "file:./vendor/cybros-agent-0.1.0-superagent.tgz",
    "@opencode/codemode": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "ajv": "8.20.0",
    "cross-spawn": "catalog:",
    "effect": "catalog:",
    "entities": "7.0.1",
    "htmlparser2": "8.0.2",
    "ipaddr.js": "^2.2.0",
    "marked": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "werift": "0.27.0",
    "ws": "^8.18.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@opencode/client": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/semver": "catalog:",
    "@types/ws": "8.18.2",
    "@typescript/native": "catalog:"
  }
}
