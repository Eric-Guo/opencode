{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/thape",
  "version": "2.2.6",
  "description": "Built-in Thape SSO, protection, and Cybros integrations for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/thape"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./sso": "./src/sso.ts",
    "./sso-protection": "./src/sso-protection.ts",
    "./cybros": "./src/cybros.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
